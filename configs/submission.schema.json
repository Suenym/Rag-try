{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SubmissionSchema",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["question_id", "relevant_chunks", "answer"],
    "properties": {
      "question_id": { "type": "integer", "minimum": 0 },
      "relevant_chunks": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["document_name", "page_number"],
          "properties": {
            "document_name": { "type": "string", "minLength": 1 },
            "page_number":  { "type": "integer", "minimum": 1 }
          }
        }
      },
      "answer": {
        "oneOf": [
          { "type": "string" },
          { "type": "number" }
        ]
      }
    }
  }
}
